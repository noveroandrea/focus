{
  "manifest_version": 3,
  "name": "Focus",
  "version": "1.0.0",
  "description": "Focus companion that helps you stay on task while studying or working.",
  "permissions": ["tabs", "storage", "scripting", "activeTab", "windows", "idle", "identity", "alarms"],
  "host_permissions": [
    "http://127.0.0.1:47317/*",
    "https://*.supabase.co/*",
    "*://*.overleaf.com/*",
    "*://overleaf.dei.unipd.it/*",
    "*://arxiv.org/*",
    "*://*.nature.com/*",
    "*://*.ieee.org/*",
    "*://ieeexplore.ieee.org/*",
    "*://claude.ai/*",
    "*://scholar.google.com/*",
    "*://*.wikipedia.org/*",
    "*://mail.google.com/*",
    "*://outlook.live.com/*",
    "*://outlook.office.com/*",
    "https://*/*.pdf",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["heartbeat.js"]
    },
    {
      "matches": ["<all_urls>"],
      "js": ["sprite.js"]
    }
  ]
}
